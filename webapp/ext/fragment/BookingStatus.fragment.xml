<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <VBox id="_IDGenBookingStatusBox">
    <MessageStrip id="_IDGenMessageStrip"
      text="This flight is fully booked. Price is locked until seats become available."
      type="Warning"
      showIcon="true"
      visible="{= ${seatsocc} >= ${seatsmax} }" />
    <ObjectStatus id="seatsAvailableStatus"
      title="Seats Available"
      text="{= ${seatsmax} - ${seatsocc} } of {seatsmax}"
      state="{= ${seatsocc} >= ${seatsmax} ? 'Error' : 'Success' }" />
  </VBox>
</core:FragmentDefinition>
